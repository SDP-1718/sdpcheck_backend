# Local development values only. Copy this file to .env before running the app.
# Never use production credentials here; .env is excluded from Git.

# Spring profile loaded from .env by Spring Boot.
spring.profiles.active=local

# Spring Boot datasource (local PostgreSQL 17).
DB_URL=jdbc:postgresql://localhost:5432/sdpcheck
DB_USERNAME=sdpcheck
DB_PASSWORD=sdpcheck

# PostgreSQL container settings used by compose.yaml.
POSTGRES_DB=sdpcheck
POSTGRES_USER=sdpcheck
POSTGRES_PASSWORD=sdpcheck
POSTGRES_PORT=5432
