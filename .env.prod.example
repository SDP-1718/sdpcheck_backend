POSTGRES_DB=sdpcheck
POSTGRES_USER=sdpcheck
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# JWT secret must be at least 32 bytes. Generate a unique random value for production.
JWT_SECRET=CHANGE_ME_TO_SECURE_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ACCESS_TOKEN_EXPIRATION=1800000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000

# Cookie policy depends on the final frontend/backend sites.
JWT_REFRESH_COOKIE_SAME_SITE=Lax

# Kakao REST API credentials; never commit real values.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Leave pending until the deployment URLs are agreed.
# Backend example: https://api.example.com/login/oauth2/code/kakao
KAKAO_REDIRECT_URI=
# Frontend example: https://app.example.com/auth/callback
FRONTEND_AUTH_CALLBACK_URL=

# Frontend origin only, without callback path. Multiple origins: comma-separated.
# Example: https://app.example.com
CORS_ALLOWED_ORIGINS=

# Keep disabled until API usage and billing are agreed.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
